<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="member_view" modification_key="wrxt_portfolio_profile_button" description="Diğer kullanıcıların profiline herkese açık portfolyo bağlantısı ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:action_top_start]-->]]></find>
    <replace><![CDATA[<!--[XF:action_top_start]-->
<xf:if is="$xf.visitor.user_id != $user.user_id">
    <xf:button href="{{ link('portfolyo/kullanici', $user) }}" class="button--link">
        Portfolyo
    </xf:button>
</xf:if>]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_list" modification_key="wrxt_portfolio_remove_personal_actions" description="Genel portfolyo vitrininden kişisel yönetim butonlarını kaldırır" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<div class="block-footer"><xf:button href="{{ link('portfolyo/add') }}" class="button--primary">Çalışma ekle</xf:button> <xf:button href="{{ link('portfolyo/mine') }}">Çalışmalarım</xf:button> <xf:button href="{{ link('portfolyo/saved') }}">Kaydedilenler</xf:button></div>]]></find>
    <replace><![CDATA[]]></replace>
  </modification>

  <modification type="public" template="account_visitor_menu" modification_key="wrxt_portfolio_account_menu" description="Kişisel portfolyo işlemlerini kullanıcı hesabı menüsüne ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:content_links:bottom]-->]]></find>
    <replace><![CDATA[<xf:if is="$xf.visitor.user_id">
    <li><a href="{{ link('portfolyo/mine') }}" class="menu-linkRow">Portfolyom</a></li>
    <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'create')">
        <li><a href="{{ link('portfolyo/add') }}" class="menu-linkRow">Yeni çalışma</a></li>
    </xf:if>
    <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'save')">
        <li><a href="{{ link('portfolyo/saved') }}" class="menu-linkRow">Kaydedilenler</a></li>
    </xf:if>
</xf:if>
<!--[XF:content_links:bottom]-->]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_mine" modification_key="wrxt_portfolio_mine_actions_empty" description="Çalışmalarım sayfasına yeni çalışma butonu ve boş durum mesajı ekler" execution_order="20" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Çalışmalarım</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$items" value="$item"><div class="block-row"><a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a> · {$item.status} · {$item.security_status} <xf:button href="{{ link('portfolyo/calisma/edit',$item) }}">Düzenle</xf:button></div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo/mine" />]]></find>
    <replace><![CDATA[<xf:title>Çalışmalarım</xf:title>
<xf:pageaction>
    <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'create')">
        <xf:button href="{{ link('portfolyo/add') }}" class="button--primary">Yeni çalışma ekle</xf:button>
    </xf:if>
</xf:pageaction>

<xf:if is="$total > 0">
    <div class="block">
        <div class="block-container">
            <div class="block-body">
                <xf:foreach loop="$items" value="$item">
                    <div class="block-row">
                        <a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a>
                        · {$item.status} · {$item.security_status}
                        <xf:button href="{{ link('portfolyo/calisma/edit',$item) }}">Düzenle</xf:button>
                    </div>
                </xf:foreach>
            </div>
        </div>
    </div>
    <xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo/mine" />
<xf:else />
    <div class="block">
        <div class="block-container">
            <div class="block-row">
                <div class="contentRow">
                    <div class="contentRow-main">
                        <h3 class="contentRow-title">Henüz portfolyo içeriğiniz yok</h3>
                        <div class="contentRow-snippet">Henüz herhangi bir portfolyo içeriği eklemediniz.</div>
                        <div class="contentRow-minor" style="margin-top:12px">
                            <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'create')">
                                <xf:button href="{{ link('portfolyo/add') }}" class="button--primary">İlk çalışmanı ekle</xf:button>
                            <xf:else />
                                Yeni çalışma oluşturmak için kullanıcı grubunuzun portfolyo oluşturma iznine sahip olması gerekir.
                            </xf:if>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</xf:if>]]></replace>
  </modification>
</template_modifications>

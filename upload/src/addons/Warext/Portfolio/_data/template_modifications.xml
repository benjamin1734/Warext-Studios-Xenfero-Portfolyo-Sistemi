<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="member_view" modification_key="wrxt_portfolio_profile_button" description="Diğer kullanıcıların profiline herkese açık portfolyo bağlantısı ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:action_top_start]-->]]></find>
    <replace><![CDATA[<!--[XF:action_top_start]-->
<xf:if is="$xf.visitor.user_id != $user.user_id">
    <xf:button href="{{ link('portfolyo/kullanici', $user) }}" class="button--link">Portfolyo</xf:button>
</xf:if>]]></replace>
  </modification>

  <modification type="public" template="account_visitor_menu" modification_key="wrxt_portfolio_account_menu" description="Kişisel portfolyo işlemlerini kullanıcı hesabı menüsüne ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:content_links:bottom]-->]]></find>
    <replace><![CDATA[<xf:if is="$xf.visitor.user_id">
    <li><a href="{{ link('portfolyo/mine') }}" class="menu-linkRow">Portfolyom</a></li>
    <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'create')"><li><a href="{{ link('portfolyo/add') }}" class="menu-linkRow">Yeni çalışma</a></li></xf:if>
    <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'save')"><li><a href="{{ link('portfolyo/saved') }}" class="menu-linkRow">Kaydedilenler</a></li></xf:if>
</xf:if>
<!--[XF:content_links:bottom]-->]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_view" modification_key="wrxt_pf_message_assets" description="Portfolyo yorumlarında XenForo'nun konu mesajı stil ve BB code paketlerini yükler" execution_order="5" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>{$portfolio.title}</xf:title><xf:css src="wrxt_portfolio.less" />]]></find>
    <replace><![CDATA[<xf:title>{$portfolio.title}</xf:title><xf:css src="wrxt_portfolio.less" /><xf:css src="message.less" /><xf:css src="bb_code.less" />]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_view" modification_key="wrxt_pf_native_comments" description="Portfolyo yorumlarını XenForo thread_view içindeki gerçek message block ve ayrı quick reply iskeletine geçirir" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<div class="block"><div class="block-container"><h2 class="block-header">Yorumlar <span class="label label--subtle">{$portfolio.comment_count}</span></h2><div class="block-body"><xf:if is="$comments is not empty"><xf:foreach loop="$comments" value="$comment"><div class="block-row"><div class="contentRow"><div class="contentRow-main"><div class="contentRow-title"><b>{$comment.username}</b></div><div class="contentRow-minor">{{ date_time($comment.created_date) }}</div><div style="margin-top:7px">{$comment.message}</div></div></div></div></xf:foreach><xf:else /><div class="block-row">Henüz yorum yapılmamış.</div></xf:if></div><xf:if is="$portfolio.status == 'published' AND $xf.visitor.user_id"><xf:form action="{{ link('portfolyo/calisma/comment',$portfolio) }}" ajax="true"><div class="block-body"><xf:textarearow name="message" rows="3" maxlength="1000" label="Yorumunuz" /></div><xf:submitrow submit="Yorum gönder" /></xf:form></xf:if></div></div>]]></find>
    <replace><![CDATA[<section class="wrxtPfComments" id="portfolio-comments">
    <div class="block">
        <div class="block-container">
            <h2 class="block-header">Yorumlar <span class="label label--subtle">{$portfolio.comment_count}</span></h2>
        </div>
    </div>

    <div class="block block--messages" data-type="comment" data-search-target="*">
        <span class="u-anchorTarget" id="comments"></span>
        <div class="block-container lbContainer"
             data-xf-init="lightbox"
             data-message-selector=".js-post"
             data-lb-id="portfolio-comments-{$portfolio.portfolio_id}">
            <div class="block-body js-replyNewMessageContainer">
                <xf:if is="$comments is not empty">
                    <xf:foreach loop="$comments" value="$comment">
                        <article class="message message--post js-post js-inlineModContainer"
                                 data-author="{$comment.username}"
                                 data-content="comment-{$comment.comment_id}"
                                 id="js-comment-{$comment.comment_id}">
                            <span class="u-anchorTarget" id="comment-{$comment.comment_id}"></span>

                            <div class="message-inner">
                                <div class="message-cell message-cell--user">
                                    <xf:macro template="message_macros"
                                              name="user_info"
                                              arg-user="{$comment.User}"
                                              arg-fallbackName="{$comment.username}" />
                                </div>

                                <div class="message-cell message-cell--main">
                                    <div class="message-main">
                                        <header class="message-attribution message-attribution--split">
                                            <div class="message-attribution-main">
                                                <a href="#comment-{$comment.comment_id}" class="u-concealed" rel="nofollow">
                                                    {{ date_dynamic($comment.created_date) }}
                                                </a>
                                            </div>
                                            <ul class="message-attribution-opposite message-attribution-opposite--list">
                                                <li><a href="#comment-{$comment.comment_id}" rel="nofollow">#{$comment.comment_id}</a></li>
                                            </ul>
                                        </header>

                                        <div class="message-content js-messageContent">
                                            <div class="message-userContent lbContainer js-lbContainer"
                                                 data-lb-id="portfolio-comment-{$comment.comment_id}"
                                                 data-lb-caption-desc="{$comment.username} · {{ date_time($comment.created_date) }}">
                                                <article class="message-body">
                                                    {{ bb_code($comment.message, 'wrxt_portfolio_comment', $comment) }}
                                                </article>
                                            </div>
                                        </div>

                                        <footer class="message-footer">
                                            <div class="message-actionBar actionBar">
                                                <div class="actionBar-set actionBar-set--internal">
                                                    <xf:if is="$comment.canReport()">
                                                        <a href="{{ link('portfolyo/calisma/comment-report', $portfolio, {'comment_id': $comment.comment_id}) }}"
                                                           class="actionBar-action"
                                                           data-xf-click="overlay">Raporla</a>
                                                    </xf:if>
                                                    <xf:if is="$comment.canDelete()">
                                                        <xf:form action="{{ link('portfolyo/calisma/comment-delete', $portfolio) }}" ajax="true" class="u-inline">
                                                            <input type="hidden" name="comment_id" value="{$comment.comment_id}" />
                                                            <button type="submit"
                                                                    class="actionBar-action"
                                                                    data-xf-click="confirm"
                                                                    data-confirm="Bu yorumu silmek istediğinize emin misiniz?">Sil</button>
                                                        </xf:form>
                                                    </xf:if>
                                                </div>
                                            </div>
                                        </footer>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </xf:foreach>
                <xf:else />
                    <div class="block-row">Henüz yorum yapılmamış. İlk yorumu siz yazabilirsiniz.</div>
                </xf:if>
            </div>
        </div>
    </div>

    <xf:if is="$portfolio.status == 'published' AND $xf.visitor.user_id AND $xf.visitor.hasPermission('wrxtPortfolio', 'comment')">
        <xf:form action="{{ link('portfolyo/calisma/comment', $portfolio) }}"
                 ajax="true"
                 class="block js-quickReply"
                 data-xf-init="ajax-submit">
            <div class="block-container">
                <div class="block-body">
                    <div class="message message--quickReply block-topRadiusContent block-bottomRadiusContent">
                        <div class="message-inner">
                            <div class="message-cell message-cell--user">
                                <div class="message-user">
                                    <div class="message-avatar">
                                        <div class="message-avatar-wrapper">
                                            <xf:avatar user="$xf.visitor" size="m" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="message-cell message-cell--main">
                                <div class="message-main">
                                    <div class="message-content">
                                        <div class="message-editorWrapper">
                                            <xf:editor name="message" placeholder="Yorumunuzu yazın..." data-min-height="140" />
                                        </div>
                                    </div>
                                    <footer class="message-footer">
                                        <div class="message-actionBar actionBar">
                                            <div class="actionBar-set actionBar-set--external">
                                                <xf:button type="submit" class="button--primary">Yorum gönder</xf:button>
                                            </div>
                                        </div>
                                    </footer>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xf:form>
    <xf:elseif is="$portfolio.status == 'published' AND !$xf.visitor.user_id" />
        <div class="block"><div class="block-container"><div class="block-footer">Yorum yapmak için giriş yapmalısınız.</div></div></div>
    </xf:if>
</section>]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_report" modification_key="wrxt_pf_comment_report_title" description="Rapor penceresini çalışma veya yorum hedefine göre adlandırır" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Raporla</xf:title>]]></find>
    <replace><![CDATA[<xf:title>{{ $comment ? 'Yorumu raporla' : 'Çalışmayı raporla' }}</xf:title>]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_report" modification_key="wrxt_pf_comment_report_action" description="Yorum raporunu yorum rapor controllerına gönderir" execution_order="20" enabled="1" action="str_replace">
    <find><![CDATA[<xf:form action="{{ link('portfolyo/calisma/report',$portfolio) }}" ajax="true" class="block">]]></find>
    <replace><![CDATA[<xf:form action="{{ $comment ? link('portfolyo/calisma/comment-report', $portfolio, {'comment_id': $comment.comment_id}) : link('portfolyo/calisma/report', $portfolio) }}" ajax="true" class="block">]]></replace>
  </modification>

  <modification type="public" template="wrxt_portfolio_report" modification_key="wrxt_pf_comment_report_reasons" description="Yorum raporlarında yorumlara uygun nedenleri gösterir" execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[<xf:selectrow name="reason_code" label="Neden"><xf:option value="stolen_work">Çalıntı çalışma</xf:option><xf:option value="copyright">Telif hakkı</xf:option><xf:option value="inappropriate">Uygunsuz içerik</xf:option><xf:option value="suspected_malicious">Şüpheli dosya</xf:option><xf:option value="spam">Spam</xf:option><xf:option value="wrong_category">Yanlış kategori</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow>]]></find>
    <replace><![CDATA[<xf:if is="$comment">
    <xf:inforow label="Raporlanan yorum"><b>{$comment.username}</b>: {{ snippet($comment.message, 180) }}</xf:inforow>
    <xf:selectrow name="reason_code" label="Neden"><xf:option value="inappropriate">Uygunsuz içerik</xf:option><xf:option value="harassment">Hakaret / taciz</xf:option><xf:option value="spam">Spam</xf:option><xf:option value="copyright">Telif / izinsiz paylaşım</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow>
<xf:else />
    <xf:selectrow name="reason_code" label="Neden"><xf:option value="stolen_work">Çalıntı çalışma</xf:option><xf:option value="copyright">Telif hakkı</xf:option><xf:option value="inappropriate">Uygunsuz içerik</xf:option><xf:option value="suspected_malicious">Şüpheli dosya</xf:option><xf:option value="spam">Spam</xf:option><xf:option value="wrong_category">Yanlış kategori</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow>
</xf:if>]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_reports" modification_key="wrxt_pf_comment_report_target" description="Yorum raporlarını ACP rapor listesinde hedef yorum ile gösterir" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<b>{$report.Portfolio.title}</b> · {$report.reporter_username}]]></find>
    <replace><![CDATA[<b>{$report.Portfolio.title}</b><xf:if is="$report.comment_id"> · <a href="{{ link('canonical:portfolyo/calisma', $report.Portfolio) }}#comment-{$report.comment_id}" target="_blank">Yorum #{$report.comment_id}</a></xf:if> · {$report.reporter_username}]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_quarantine" modification_key="wrxt_pf_queue_help" description="Karantina ve moderasyon akışını yöneticilere açıklar" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Karantina ve İşlem Kuyruğu</xf:title>]]></find>
    <replace><![CDATA[<xf:title>Karantina ve İşlem Kuyruğu</xf:title>
<div class="blockMessage blockMessage--important">
    <b>Yayın akışı:</b> Karantina → doğrulama → ClamAV taraması → görsel/3D işleme → teknik kontrol tamamlandı → <b>Portfolyo Moderasyonu</b> → manuel yayın onayı.
    Buradaki <b>Şimdi işle / yeniden dene</b> butonu dosyayı sadece kuyruğa eklemez; işlemi o anda çalıştırır ve sonucu ekranda gösterir.
    <div style="margin-top:8px"><a href="{{ link('wrxt-portfolyo/moderation') }}" class="button button--link">Portfolyo Moderasyonunu aç</a></div>
</div>]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_quarantine" modification_key="wrxt_pf_queue_run_action" description="Karantina yeniden deneme işlemini anlık işlem controllerına yönlendirir" execution_order="20" enabled="1" action="str_replace">
    <find><![CDATA[<xf:form action="{{ link('wrxt-portfolyo/quarantine-retry') }}" ajax="true">]]></find>
    <replace><![CDATA[<xf:form action="{{ link('wrxt-portfolyo-queue/run') }}">]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_quarantine" modification_key="wrxt_pf_queue_run_label" description="Kuyruk işlem butonunu daha anlaşılır hale getirir" execution_order="30" enabled="1" action="str_replace">
    <find><![CDATA[>İşlemi yeniden dene</xf:button>]]></find>
    <replace><![CDATA[>Şimdi işle / yeniden dene</xf:button>]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_quarantine" modification_key="wrxt_pf_queue_continue_action" description="ClamAV devam işlemini anlık işleme bağlar" execution_order="40" enabled="1" action="str_replace">
    <find><![CDATA[<xf:form action="{{ link('wrxt-portfolyo/quarantine-continue') }}" ajax="true">]]></find>
    <replace><![CDATA[<xf:form action="{{ link('wrxt-portfolyo-queue/continue') }}">]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_admin_moderation" modification_key="wrxt_pf_moderation_help" description="Manuel yayın onayının nerede yapıldığını açıklar" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Portfolyo Moderasyonu</xf:title>]]></find>
    <replace><![CDATA[<xf:title>Portfolyo Moderasyonu</xf:title>
<div class="blockMessage blockMessage--important">
    <b>Manuel onay ekranı burasıdır.</b> Yalnızca bütün dosyaları teknik güvenlik ve işleme kontrollerini geçen çalışmalar burada görünür. <b>Onayla ve yayınla</b> işlemi çalışmayı genel Portfolyo vitrinine açar. İşleme aşamasında olan içerikler önce Karantina / İşlem Kuyruğu ekranında tamamlanmalıdır.
    <div style="margin-top:8px"><a href="{{ link('wrxt-portfolyo/quarantine') }}" class="button button--link">Karantina / İşlem Kuyruğunu aç</a></div>
</div>]]></replace>
  </modification>

  <modification type="admin" template="wrxt_portfolio_security_dashboard" modification_key="wrxt_pf_processing_diag_help" description="cPanel işleme yöntemlerini güvenlik merkezinde açıklar" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Portfolyo Güvenlik Merkezi</xf:title>]]></find>
    <replace><![CDATA[<xf:title>Portfolyo Güvenlik Merkezi</xf:title>
<div class="blockMessage">
    <b>İşleme notu:</b> Görseller öncelikle izole PHP worker ile işlenir. cPanel'de <code>proc_open</code> veya PHP CLI kapalıysa Imagick/GD üzerinden güvenli yerel WebP fallback kullanılır. <b>GLB 3D modeller için izole worker zorunludur</b>; worker kullanılamıyorsa neden Karantina ekranında açıkça gösterilir.
</div>]]></replace>
  </modification>
</template_modifications>

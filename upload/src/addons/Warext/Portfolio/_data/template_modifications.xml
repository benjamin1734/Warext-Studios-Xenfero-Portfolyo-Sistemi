<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="public" template="member_view" modification_key="wrxt_portfolio_profile_button" description="Kullanıcı profiline portfolyo bağlantısı ekler" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:action_top_start]-->]]></find>
    <replace><![CDATA[<!--[XF:action_top_start]-->
<xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'view')">
    <xf:button href="{{ link('portfolyo/kullanici', $user) }}" class="button--link">
        {{ phrase('wrxt_portfolio_profile_button') }}
    </xf:button>
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="wrxt_portfolio_list" modification_key="wrxt_portfolio_list_actions" description="Portfolyo kullanıcı işlemlerini sayfanın üstünde görünür hale getirir" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<xf:title>Portfolyo</xf:title>]]></find>
    <replace><![CDATA[<xf:title>Portfolyo</xf:title>
<xf:if is="$xf.visitor.user_id">
<div class="block">
    <div class="block-container">
        <div class="block-row">
            <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'create')"><xf:button href="{{ link('portfolyo/add') }}" class="button--primary">Yeni Çalışma</xf:button></xf:if>
            <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'view')"> <xf:button href="{{ link('portfolyo/mine') }}">Çalışmalarım</xf:button></xf:if>
            <xf:if is="$xf.visitor.hasPermission('wrxtPortfolio', 'save')"> <xf:button href="{{ link('portfolyo/saved') }}">Kaydedilenler</xf:button></xf:if>
        </div>
    </div>
</div>
</xf:if>]]></replace>
  </modification>
</template_modifications>

<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="wrxt_portfolio_list" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo</xf:title><xf:form action="{{ link('portfolyo') }}" method="get" class="block"><div class="block-container"><div class="block-body"><xf:selectrow name="category_id" value="{$filters.category_id}" label="Kategori"><xf:option value="0">Tüm kategoriler</xf:option><xf:foreach loop="$categories" value="$category"><xf:option value="{$category.category_id}">{$category.title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="portfolio_type" value="{$filters.portfolio_type}" label="Tür"><xf:option value="">Tümü</xf:option><xf:option value="image">Görsel</xf:option><xf:option value="model3d">3D</xf:option></xf:selectrow><xf:selectrow name="sort" value="{$filters.sort}" label="Sıralama"><xf:option value="latest">En yeni</xf:option><xf:option value="popular">En beğenilen</xf:option><xf:option value="viewed">En çok görüntülenen</xf:option><xf:option value="discussed">En çok yorumlanan</xf:option><xf:option value="oldest">En eski</xf:option></xf:selectrow></div><xf:submitrow submit="Filtrele" /></div></xf:form><div class="block"><div class="block-container"><h2 class="block-header">Topluluk Portfolyosu</h2><div class="block-body"><xf:foreach loop="$items" value="$item"><div class="block-row"><a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a><div class="contentRow-minor">{$item.username} · {$item.Category.title} · ❤ {$item.like_count} · 👁 {$item.view_count} · 💬 {$item.comment_count}</div></div></xf:foreach></div><div class="block-footer"><xf:button href="{{ link('portfolyo/add') }}" class="button--primary">Çalışma ekle</xf:button> <xf:button href="{{ link('portfolyo/mine') }}">Çalışmalarım</xf:button> <xf:button href="{{ link('portfolyo/saved') }}">Kaydedilenler</xf:button></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo" params="{$filters}" />]]></template>
  <template type="public" title="wrxt_portfolio_view" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>{$portfolio.title}</xf:title><xf:js src="warext/portfolio/community.js" min="1" /><div class="block"><div class="block-container"><h2 class="block-header">{$portfolio.title}</h2><div class="block-body"><div class="block-row"><a href="{{ link('portfolyo/kullanici',$portfolio.User) }}">{$portfolio.username}</a> · {$portfolio.Category.title} · 👁 {$portfolio.view_count}<xf:if is="$portfolio.CoverFile"><div><img src="{{ link('portfolyo/calisma/media',$portfolio,{'file_id':$portfolio.CoverFile.file_id}) }}" alt="{$portfolio.title}" style="max-width:100%;max-height:720px" /></div></xf:if><xf:if is="$modelFile"><iframe src="{{ link('portfolyo/calisma/model-frame',$portfolio) }}" title="{$portfolio.title}" sandbox="allow-scripts" allow="fullscreen" loading="lazy" referrerpolicy="no-referrer" style="width:100%;min-height:420px;border:0"></iframe></xf:if><div>{{ bb_code($portfolio.description,'wrxt_portfolio',$portfolio) }}</div></div><xf:foreach loop="$galleryFiles" value="$file"><div class="block-row"><img src="{{ link('portfolyo/calisma/media',$portfolio,{'file_id':$file.file_id}) }}" alt="{$portfolio.title}" style="max-width:100%" /></div></xf:foreach></div><div class="block-footer"><xf:form action="{{ link('portfolyo/calisma/like',$portfolio) }}" ajax="true" style="display:inline"><xf:button type="submit">Beğen · {$portfolio.like_count}</xf:button></xf:form> <xf:form action="{{ link('portfolyo/calisma/save-item',$portfolio) }}" ajax="true" style="display:inline"><xf:button type="submit">Kaydet · {$portfolio.save_count}</xf:button></xf:form> <xf:if is="$portfolio.canReport()"><xf:button href="{{ link('portfolyo/calisma/report',$portfolio) }}" overlay="true">Raporla</xf:button></xf:if> <xf:if is="$portfolio.canEdit()"><xf:button href="{{ link('portfolyo/calisma/edit',$portfolio) }}">Düzenle</xf:button></xf:if></div></div></div><div class="block"><div class="block-container"><h2 class="block-header">Yorumlar</h2><div class="block-body"><xf:foreach loop="$comments" value="$comment"><div class="block-row"><b>{$comment.username}</b> · {{ date_time($comment.created_date) }}<div>{$comment.message}</div></div></xf:foreach></div><xf:form action="{{ link('portfolyo/calisma/comment',$portfolio) }}" ajax="true"><div class="block-body"><xf:textarearow name="message" rows="3" maxlength="1000" label="Yorumunuz" /></div><xf:submitrow submit="Yorum gönder" /></xf:form></div></div>]]></template>
  <template type="public" title="wrxt_portfolio_add" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo çalışması ekle</xf:title><xf:form action="{{ link('portfolyo/save') }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:textboxrow name="title" maxlength="150" label="Başlık" /><xf:selectrow name="category_id" label="Kategori"><xf:option value="0">Kategori seçin</xf:option><xf:foreach loop="$categories" value="$category"><xf:option value="{$category.category_id}">{$category.title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="portfolio_type" label="Tür"><xf:option value="image">Görsel</xf:option><xf:option value="model3d">3D model</xf:option></xf:selectrow><xf:textboxrow name="programs" maxlength="255" label="Programlar" /><xf:textboxrow name="tags" maxlength="500" label="Etiketler" /><xf:textarearow name="description" rows="8" label="Açıklama" /></div><xf:submitrow submit="Taslağı oluştur" /></div></xf:form>]]></template>
  <template type="public" title="wrxt_portfolio_edit" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>{$portfolio.title} - Düzenle</xf:title><xf:form action="{{ link('portfolyo/calisma/save',$portfolio) }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:textboxrow name="title" value="{$portfolio.title}" maxlength="150" label="Başlık" /><xf:selectrow name="category_id" value="{$portfolio.category_id}" label="Kategori"><xf:foreach loop="$categories" value="$category"><xf:option value="{$category.category_id}">{$category.title}</xf:option></xf:foreach></xf:selectrow><xf:selectrow name="portfolio_type" value="{$portfolio.portfolio_type}" label="Tür"><xf:option value="image">Görsel</xf:option><xf:option value="model3d">3D model</xf:option></xf:selectrow><xf:textboxrow name="programs" value="{$portfolio.programs}" maxlength="255" label="Programlar" /><xf:textboxrow name="tags" value="{$portfolio.tags_cache}" maxlength="500" label="Etiketler" /><xf:textarearow name="description" value="{$portfolio.description}" rows="8" label="Açıklama" /></div><xf:submitrow submit="Kaydet" /></div></xf:form><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$files" value="$file"><div class="block-row">{$file.original_name} · {$file.state} · {$file.processing_status}</div></xf:foreach></div></div></div><xf:form action="{{ link('portfolyo/calisma/upload',$portfolio) }}" method="post" upload="true" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:selectrow name="file_role" label="Görev"><xf:option value="cover">Kapak</xf:option><xf:option value="gallery">Galeri</xf:option><xf:option value="model">3D model</xf:option></xf:selectrow><xf:uploadrow name="portfolio_file" accept=".jpg,.jpeg,.png,.webp,.glb" label="Dosya" /></div><xf:submitrow submit="Yükle" /></div></xf:form>]]></template>
  <template type="public" title="wrxt_portfolio_delete" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Çalışmayı sil</xf:title><xf:form action="{{ link('portfolyo/calisma/delete',$portfolio) }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><div class="block-row">{$portfolio.title} silinsin mi?</div></div><xf:submitrow submit="Sil" /></div></xf:form>]]></template>
  <template type="public" title="wrxt_portfolio_mine" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Çalışmalarım</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$items" value="$item"><div class="block-row"><a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a> · {$item.status} · {$item.security_status} <xf:button href="{{ link('portfolyo/calisma/edit',$item) }}">Düzenle</xf:button></div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo/mine" />]]></template>
  <template type="public" title="wrxt_portfolio_user" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>{$user.username} - Portfolyo</xf:title><div class="block"><div class="block-container"><h2 class="block-header">{$user.username}</h2><div class="block-body"><div class="block-row">{$followStats.followers} takipçi · {$followStats.following} takip</div><xf:if is="$xf.visitor.user_id AND $xf.visitor.user_id != $user.user_id"><div class="block-row"><xf:form action="{{ link('portfolyo/kullanici/follow',$user) }}" ajax="true"><xf:button type="submit">{{ $isFollowing ? 'Takibi bırak' : 'Takip et' }}</xf:button></xf:form></div></xf:if><xf:foreach loop="$items" value="$item"><div class="block-row"><a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a> · ❤ {$item.like_count} · 👁 {$item.view_count}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo/kullanici" data="{$user}" />]]></template>
  <template type="public" title="wrxt_portfolio_saved" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Kaydedilenler</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$items" value="$item"><div class="block-row"><a href="{{ link('portfolyo/calisma',$item) }}"><b>{$item.title}</b></a> · {$item.username}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="portfolyo/saved" />]]></template>
  <template type="public" title="wrxt_portfolio_report" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Raporla</xf:title><xf:form action="{{ link('portfolyo/calisma/report',$portfolio) }}" ajax="true" class="block"><div class="block-container"><div class="block-body"><xf:selectrow name="reason_code" label="Neden"><xf:option value="stolen_work">Çalıntı çalışma</xf:option><xf:option value="copyright">Telif hakkı</xf:option><xf:option value="inappropriate">Uygunsuz içerik</xf:option><xf:option value="suspected_malicious">Şüpheli dosya</xf:option><xf:option value="spam">Spam</xf:option><xf:option value="wrong_category">Yanlış kategori</xf:option><xf:option value="other">Diğer</xf:option></xf:selectrow><xf:textarearow name="message" maxlength="1500" rows="5" label="Açıklama" /></div><xf:submitrow submit="Raporu gönder" /></div></xf:form>]]></template>
  <template type="public" title="approval_item_wrxt_portfolio" version_id="1000102" version_string="1.0.2"><![CDATA[<div class="block-row"><b>{$content.ModerationTitle}</b><div>{{ bb_code($content.ModerationDescription,'wrxt_portfolio',$content) }}</div></div>]]></template>
  <template type="public" title="alert_user_wrxt_portfolio_like" version_id="1000102" version_string="1.0.2"><![CDATA[<a href="{$alert.extra.portfolio_url}">{$alert.FromUser.username}</a> çalışmanızı beğendi.]]></template>
  <template type="public" title="alert_user_wrxt_portfolio_comment" version_id="1000102" version_string="1.0.2"><![CDATA[<a href="{$alert.extra.portfolio_url}">{$alert.FromUser.username}</a> çalışmanıza yorum yaptı.]]></template>
  <template type="public" title="alert_user_wrxt_portfolio_follow" version_id="1000102" version_string="1.0.2"><![CDATA[<a href="{$alert.extra.profile_url}">{$alert.FromUser.username}</a> sizi takip etti.]]></template>
  <template type="public" title="alert_user_wrxt_portfolio_new" version_id="1000102" version_string="1.0.2"><![CDATA[<a href="{$alert.extra.portfolio_url}">{$alert.FromUser.username}</a> yeni bir çalışma yayınladı.]]></template>
  <template type="admin" title="wrxt_portfolio_admin_list" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$items" value="$item"><div class="block-row"><b>{$item.title}</b> · {$item.username} · {$item.status} · {$item.security_status}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo" />]]></template>
  <template type="admin" title="wrxt_portfolio_security_dashboard" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo Güvenlik Merkezi</xf:title><div class="block"><div class="block-container"><div class="block-body"><div class="block-row">Karantina: {$summary.quarantine} · Engellenen: {$summary.blocked} · Açık rapor: {$summary.open_reports} · Aktif hash: {$summary.blocked_hashes}</div></div><div class="block-footer"><a href="{{ link('wrxt-portfolyo/quarantine') }}">Karantina</a> · <a href="{{ link('wrxt-portfolyo/blocked') }}">Engellenenler</a> · <a href="{{ link('wrxt-portfolyo/hashes') }}">Hash blacklist</a> · <a href="{{ link('wrxt-portfolyo/events') }}">Olaylar</a> · <a href="{{ link('wrxt-portfolyo/audit') }}">Audit</a> · <a href="{{ link('wrxt-portfolyo/reports') }}">Raporlar</a></div></div></div>]]></template>
  <template type="admin" title="wrxt_portfolio_security_reports" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo raporları</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$reports" value="$report"><div class="block-row"><b>{$report.Portfolio.title}</b> · {$report.reporter_username} · {$report.reason_code} · {$report.state}<div>{$report.message}</div></div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo/reports" />]]></template>
  <template type="admin" title="wrxt_portfolio_security_quarantine" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Karantina</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$files" value="$file"><div class="block-row">{$file.original_name} · {$file.username} · {$file.state} · {$file.detected_mime} · {$file.file_size} bayt</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo/quarantine" />]]></template>
  <template type="admin" title="wrxt_portfolio_security_blocked" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Engellenen dosyalar</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$files" value="$file"><div class="block-row">{$file.original_name} · {$file.username} · {$file.reason_code} · {$file.sha256}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo/blocked" />]]></template>
  <template type="admin" title="wrxt_portfolio_security_hashes" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Hash Blacklist</xf:title><xf:form action="{{ link('wrxt-portfolyo/hash-save') }}" class="block" ajax="true"><div class="block-container"><div class="block-body"><xf:textboxrow name="sha256" label="SHA-256" maxlength="64" /><xf:textboxrow name="reason_code" label="Neden" value="manual_block" /><xf:textboxrow name="note" label="Not" /></div><xf:submitrow submit="Kaydet" /></div></xf:form><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$rows" value="$row"><div class="block-row">{$row.sha256} · {$row.reason_code} · {{ $row.is_active ? 'Aktif' : 'Pasif' }}</div></xf:foreach></div></div></div>]]></template>
  <template type="admin" title="wrxt_portfolio_security_events" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Güvenlik olayları</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$events" value="$event"><div class="block-row">{$event.severity} · {$event.event} · {$event.reason_code} · {{ date_time($event.created_date) }}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo/events" />]]></template>
  <template type="admin" title="wrxt_portfolio_security_audit" version_id="1000102" version_string="1.0.2"><![CDATA[<xf:title>Portfolyo Audit Log</xf:title><div class="block"><div class="block-container"><div class="block-body"><xf:foreach loop="$logs" value="$log"><div class="block-row">{$log.actor_username} · {$log.action} · {$log.target_type} #{$log.target_id} · {{ date_time($log.created_date) }}</div></xf:foreach></div></div></div><xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="wrxt-portfolyo/audit" />]]></template>
</templates>
